{
  "name": "english-peers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute english-peers --remote --file=schema.sql",
    "db:seed": "wrangler d1 execute english-peers --remote --file=seed.sql",
    "db:init:local": "wrangler d1 execute english-peers --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute english-peers --local --file=seed.sql"
  },
  "devDependencies": { "wrangler": "^4" }
}
