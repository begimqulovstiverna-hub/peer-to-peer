{
  "name": "peer-to-peer",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-peers-db",
      "database_id": "378e79af-1f57-4de5-b871-b05f9bf58115"
    }
  ]
}
